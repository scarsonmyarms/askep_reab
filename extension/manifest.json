{
  "manifest_version": 3,
  "name": "Askep: кодування діагнозів (реабілітація)",
  "version": "2.0.0",
  "description": "Панель на сторінці Askep: підбір основного та супутніх діагнозів за формулами НСЗУ, перевірка і заповнення форми.",
  "action": {
    "default_title": "Кодування діагнозів — показати / сховати панель",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["activeTab", "scripting", "storage"]
}
